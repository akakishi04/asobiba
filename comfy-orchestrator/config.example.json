{
  "comfyui": {
    "base_url": "http://127.0.0.1:8188",
    "timeout_seconds": 60,
    "poll_seconds": 2,
    "generation_timeout_seconds": 1800,
    "free_before_llm": true,
    "video_generation_timeout_seconds": 7200
  },
  "workflows": {
    "wai_t2i_basic": {
      "kind": "t2i",
      "description": "waiIllustrious SDXL v1.7 / アニメ・イラスト用。短い自然文を具体的な画像生成プロンプトへ整形する。GPU負荷を抑えるため、必要がなければ1024x1024・28stepsを超えない。",
      "file": "workflows/wai_t2i_basic.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "width": {
          "node": "10",
          "input": "width"
        },
        "height": {
          "node": "10",
          "input": "height"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "width": 1024,
        "height": 1024,
        "steps": 28,
        "cfg": 5.5
      }
    },
    "wai_i2i_basic": {
      "kind": "i2i",
      "description": "waiIllustrious SDXL v1.7。参照画像の構図や色を基に自然文で全体を描き直す。入力画像の解像度を使用し、denoiseの低い値ほど元画像を維持する。",
      "file": "workflows/wai_i2i_basic.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "image": {
          "node": "16",
          "input": "image"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        },
        "denoise": {
          "node": "11",
          "input": "denoise"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "steps": 28,
        "cfg": 5.5,
        "denoise": 0.53
      }
    },
    "wai_inpaint_basic": {
      "kind": "inpaint",
      "description": "元の絵の白マスク指定部分だけを描き直す部分修正（Illustrious SDXL）。マスク外のピクセルは合成で保護。素材の色や形を保つよう修正内容を明確に。",
      "file": "workflows/wai_inpaint_basic.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "image": {
          "node": "16",
          "input": "image"
        },
        "mask": {
          "node": "19",
          "input": "image"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        },
        "denoise": {
          "node": "11",
          "input": "denoise"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "steps": 28,
        "cfg": 5.5,
        "denoise": 0.65
      }
    },
    "wai_pose_skeleton": {
      "kind": "pose",
      "description": "OpenPose形式の骨格画像のみ参照してIllustrious SDXLで新しいイラストを生成。骨格以外の外観を画像から引き継がない。追加のSDXL ControlNetが必要。",
      "file": "workflows/wai_pose_skeleton.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "pose": {
          "node": "21",
          "input": "image"
        },
        "width": {
          "node": "10",
          "input": "width"
        },
        "height": {
          "node": "10",
          "input": "height"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        },
        "control_strength": {
          "node": "23",
          "input": "strength"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "width": 768,
        "height": 768,
        "steps": 28,
        "cfg": 5.5,
        "control_strength": 0.85
      }
    },
    "wai_pose_detect": {
      "kind": "pose",
      "description": "DesignDollなどの通常の人物画像からDWPoseで骨格を検出し、そのポーズだけ使って新しいイラストを生成。comfyui_controlnet_auxおよびSDXL ControlNetが必要。",
      "file": "workflows/wai_pose_detect.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "pose": {
          "node": "21",
          "input": "image"
        },
        "width": {
          "node": "10",
          "input": "width"
        },
        "height": {
          "node": "10",
          "input": "height"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        },
        "control_strength": {
          "node": "23",
          "input": "strength"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "width": 768,
        "height": 768,
        "steps": 28,
        "cfg": 5.5,
        "control_strength": 0.85
      }
    },
