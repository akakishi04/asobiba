  "llm": {
    "provider": "lmstudio",
    "base_url": "http://127.0.0.1:1234",
    "model": "SELECT_IN_GUI",
    "timeout_seconds": 240,
    "context_length": 8192,
    "unload_after_inference": true,
    "token_env": "LMSTUDIO_API_TOKEN",
    "max_tokens": 4096,
    "inference_timeout_seconds": 600,
    "send_reference_to_llm": false,
    "t2i_prompt_profile": "illustrious_v2",
    "i2i_prompt_profile": "preserve_edit_v1",
    "h3_prompt_profile": "h3_illustration_v1"
  },
