{
  "comfyui": {
    "base_url": "http://127.0.0.1:8188",
    "timeout_seconds": 60,
    "poll_seconds": 2,
    "generation_timeout_seconds": 1800,
    "free_before_llm": true
  },
  "workflows": {
    "wai_t2i_basic": {
      "kind": "t2i",
      "description": "waiIllustrious SDXL v1.7 / アニメ・イラスト用。短い自然文を具体的な画像生成プロンプトへ整形する。GPU負荷を抑えるため、必要がなければ1024x1024・28stepsを超えない。",
      "file": "workflows/wai_t2i_basic.api.json",
      "bindings": {
        "positive_prompt": {
          "node": "8",
          "input": "text"
        },
        "negative_prompt": {
          "node": "5",
          "input": "text"
        },
        "width": {
          "node": "10",
          "input": "width"
        },
        "height": {
          "node": "10",
          "input": "height"
        },
        "steps": {
          "node": "11",
          "input": "steps"
        },
        "cfg": {
          "node": "11",
          "input": "cfg"
        },
        "seed": {
          "node": "11",
          "input": "seed"
        }
      },
      "defaults": {
        "negative_prompt": "low quality, blurry, bad anatomy, extra fingers",
        "width": 1024,
        "height": 1024,
        "steps": 28,
        "cfg": 5.5
      }
    }
  },
  "llm": {
    "provider": "lmstudio",
    "base_url": "http://127.0.0.1:1234",
    "model": "SELECT_IN_GUI",
    "timeout_seconds": 240,
    "context_length": 8192,
    "unload_after_inference": true,
    "token_env": "LMSTUDIO_API_TOKEN",
    "max_tokens": 4096
  },
  "ui": {
    "workflow": "wai_t2i_basic",
    "width": 768,
    "height": 768,
    "steps": 20,
    "cfg": 5,
    "seed": ""
  }
}
